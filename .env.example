# Node.js web server (localhost only)
PORT=8000
# Empty means deterministic local source retrieval; not a simulated NIM response.
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# OCR requires the multilingual SKU and its actual supported endpoint.
# Hosted candidate: https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2
# Self-hosted OCR NIM contract: http://YOUR_GPU_SERVER:8000/v1/ocr
NIM_OCR_URL=
# Optional separate lightweight model for advisory Korean->English glosses.
# Glosses never replace original input, disease codes, product names, or quotes.
TRANSLATION_MODEL=
# data.go.kr decoded service key, DrugPrdtPrmsnInfoService08 subscription
MFDS_API_KEY=
# Optional overrides. Defaults use this project's .venv and .local-data.
# PDF_PYTHON=/absolute/path/to/python
# DATA_DIR=/absolute/private/path/insurelens

# auto: use native NAT workflow when integrations/nat/.venv is installed, else Node loop
AGENT_RUNNER=auto

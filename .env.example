# Python FastAPI server (localhost only)
PORT=8000
# Required for investigations. Missing key blocks the agent; no local fallback.
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional separately deployed NeMo platform; hosted NIM needs no platform URL.
NEMO_MICROSERVICES_BASE_URL=
# Optional multilingual image OCR endpoint; leave empty if not used.
# Hosted: https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2
# Self-hosted: http://YOUR_GPU_SERVER:8000/v1/ocr
NIM_OCR_URL=
# Optional advisory Korean->English gloss model. Never replaces original strings.
TRANSLATION_MODEL=
# Optional decoded data.go.kr DrugPrdtPrmsnInfoService08 service key.
MFDS_API_KEY=
# Defaults use the running Python and the project .local-data directory.
# PDF_PYTHON=/absolute/path/to/python
# DATA_DIR=/absolute/private/path/insurelens
